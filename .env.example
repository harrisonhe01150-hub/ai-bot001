# Copy this file to `.env` for local dev, and set the same variable in
# Vercel → Project → Settings → Environment Variables for production.
#
# Use a NEW, freshly-rotated DeepSeek key. The old key (sk-d71be6...) was
# committed to a public repo and must be revoked.

DEEPSEEK_API_KEY=sk-your-new-deepseek-key-here

# ── 远程知识库（让官网也用上老板在企业微信里新加的知识）──────────
# 微信客服服务暴露的只读快照接口。不设 KB_REMOTE_URL 就完全跳过，
# 官网只用 lib/knowledge.js 里硬编码的那份（行为跟以前一样）。
# KB_REMOTE_URL=https://kf.hzmarvy.com/kb
# 必须与客服服务 .env 里的 KB_SHARED_TOKEN 完全一致，否则接口返回 401。
# KB_REMOTE_TOKEN=

# Optional: only set this if you embed the widget on a DIFFERENT domain than
# where the /api/chat function is hosted. Leave unset for same-origin use.
# ALLOW_ORIGIN=https://your-site.com
